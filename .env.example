# ==============================================================================
# Ooh Gas Multi-Supplier LPG Delivery Platform - Environment Variables
# ==============================================================================

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Mapbox Public Access Token (client-safe, starts with pk.)
# Required for real interactive vector maps, geocoding search, and reverse geocoding.
# Get a free token at https://account.mapbox.com
VITE_MAPBOX_ACCESS_TOKEN=""

# Supabase Public Configuration (client-safe)
# Used by frontend client initialized with Row Level Security (RLS) policies
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Supabase Service Role Secret (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used only by trusted server background tasks or administrative migrations
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Admin Access Password for localized admin management endpoints
ADMIN_PASSWORD="admin2026"

# ==============================================================================
# PayHero Kenya Payment Gateway (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used for server-side Lipa Na M-Pesa STK Push and Webhook Verification
# ==============================================================================
PAYHERO_API_KEY=""
PAYHERO_API_SECRET=""
PAYHERO_CHANNEL_ID=""
PAYHERO_WEBHOOK_SECRET=""

